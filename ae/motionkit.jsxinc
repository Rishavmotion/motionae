// draws an icon as its own shape layer, centred at x,y
function icon(name, type, x, y, sz, col, sw, rot) {
    var L = shape(name, x, y);
    var parts = ICONS[type];
    var swv = sw || Math.max(2, sz * 0.085);
    for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        var g = group(L, "Part " + (i + 1));
        if (p.p) addPath(L, g, sc(p.p, sz), p.c, p.i ? sc(p.i, sz) : null, p.o ? sc(p.o, sz) : null);
        if (p.e) addEllipse(L, g, p.e[2] * 2 * sz, p.e[2] * 2 * sz, [p.e[0] * sz, p.e[1] * sz]);
        if (p.r) addRect(L, g, p.r[2] * sz, p.r[3] * sz, p.r[4] * sz, [p.r[0] * sz, p.r[1] * sz]);
        if (p.star) { var s = addStar(L, g, p.star[0], p.star[1] * sz, p.star[2] * sz, p.star[3] || 0); }
        if (p.f) addFill(L, g, col); else addStroke(L, g, col, swv);
    }
    if (rot) tr(L, "ADBE Rotate Z").setValue(rot);
    return L;
}

// ---------------------------------------------------------------- media slots
function roundRectShape(x0, y0, w, h, r) {
    var k = r * KAPPA;
    var s = new Shape();
    s.vertices = [[x0 + r, y0], [x0 + w - r, y0], [x0 + w, y0 + r], [x0 + w, y0 + h - r], [x0 + w - r, y0 + h], [x0 + r, y0 + h], [x0, y0 + h - r], [x0, y0 + r]];
    s.inTangents = [[-k, 0], [0, 0], [0, -k], [0, 0], [k, 0], [0, 0], [0, k], [0, 0]];
    s.outTangents = [[0, 0], [k, 0], [0, 0], [0, k], [0, 0], [-k, 0], [0, 0], [0, -k]];
    s.closed = true;
    return s;
}
// Creates a "MEDIA · ..." precomp (drop your image/video inside) and places it masked.
function media(name, w, h, r, x, y, o) {
    o = o || {};
    var tag = CTX.comp.name.substr(0, 2);
    var pc = app.project.items.addComp("MEDIA " + tag + " · " + name, w, h, 1, CTX.comp.duration, 30);
    pc.parentFolder = FOLD.media;
    pc.comment = "Replace: drop your image/video in here and scale it to fill. Delete the placeholder layers.";
    var bg = pc.layers.addSolid([0.8, 0.8, 0.82], "Placeholder (delete)", w, h, 1, CTX.comp.duration);
    var rp = bg.property(FX).addProperty("ADBE Ramp");
    rp.property("ADBE Ramp-0001").setValue([0, 0]);
    rp.property("ADBE Ramp-0002").setValue(hex(o.c1 || "#E3E3E8"));
    rp.property("ADBE Ramp-0003").setValue([w, h]);
    rp.property("ADBE Ramp-0004").setValue(hex(o.c2 || "#C7C7CC"));
    if (w >= 160) {
        var lt = pc.layers.addText(o.label || "Drop media here");
        var sp = lt.property("ADBE Text Properties").property("ADBE Text Document");
        var d = sp.value;
        d.resetCharStyle(); d.font = FONT.med; d.fontSize = Math.max(14, Math.min(28, w / 14));
        d.applyFill = true; d.fillColor = hex(o.lc || "#8E8E93"); d.applyStroke = false;
        d.justification = ParagraphJustification.CENTER_JUSTIFY;
        sp.setValue(d);
        lt.name = "Placeholder label (delete)";
        lt.property(TR).property("ADBE Position").setValue([w / 2, h / 2 + 8]);
    }
    var L = CTX.comp.layers.add(pc);
    L.name = name;
    pos(L, [x + w / 2, y + h / 2]);   // x,y = top-left corner; anchor stays centred for clean scaling
    var m = L.property("ADBE Mask Parade").addProperty("ADBE Mask Atom");
    m.name = "Corner Radius";
    L.property("ADBE Mask Parade").property(1).property("ADBE Mask Shape").setValue(roundRectShape(0, 0, w, h, Math.min(r, w / 2, h / 2)));
    return L;
}

// ---------------------------------------------------------------- sound
function sfx(key, t, vol) {
    if (!SFX[key]) { LOG("missing sfx " + key); return null; }
    var L = CTX.comp.layers.add(SFX[key]);
    L.startTime = t;
    L.name = "SFX · " + key;
    L.label = 11;
    var lv = L.property("ADBE Audio Group").property("ADBE Audio Levels");
    lv.setValue([vol || 0, vol || 0]);
    // plain arithmetic only: audio expressions are evaluated per sample and are picky
    lv.expression = 'var C=thisComp.layer("CONTROLS");var g=C.effect("SFX Volume (dB)")(1);if(C.effect("Mute SFX")(1)>0){g=-192;}[value[0]+g,value[1]+g];';
    L.moveToEnd();
    return L;
}
